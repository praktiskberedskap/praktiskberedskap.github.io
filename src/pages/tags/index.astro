---
import TagCloud from "@components/TagCloud/TagCloud.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Stikkort" description="Artikler om beredskap samlet via stikkord">
	<section class="site-container">
		<div class="mx-auto max-w-3xl pt-24 md:pt-36">
			<h1 class="h1 text-center">Stikkord</h1>
			<hr class="bg-primary-600/50 mx-auto mt-4 max-w-[30%] rounded-full border-none pt-1" />
			<!-- display tags -->
			<div class="mt-10 flex justify-center">
				<TagCloud showCount={true} />
			</div>
		</div>
	</section>
</BaseLayout>
