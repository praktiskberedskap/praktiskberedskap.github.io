---
import CategoryCloud from "@components/CategoryCloud/CategoryCloud.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Beredskapstemaer" description="Oversikt over alle beredskapstemaene med tips og råd om beredskap">
	<section class="site-container">
		<div class="mx-auto max-w-3xl pt-24 md:pt-36">
			<h1 class="h1 text-center">Beredskapstemaer</h1>
			<hr class="bg-primary-600/50 mx-auto mt-4 max-w-[30%] rounded-full border-none pt-1" />
			<!-- display categories -->
			<div class="mt-10 flex justify-center">
				<CategoryCloud showCount={false} />
			</div>
		</div>
	</section>
</BaseLayout>
